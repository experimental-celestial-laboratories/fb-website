---
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import { Image } from 'astro:assets';
import { Nav } from "@/components/Nav";
import titleImg from "@/assets/render.png";
import prideImg from "@/assets/render-june.png";
import { ClientRouter } from "astro:transitions";

const logo = new Date().getMonth() === 5 ? prideImg : titleImg;
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Firebomb 2{title ? ` - ${title}` : ""}</title>
		<ClientRouter />
	</head>
	<body>
		<div id="center" class="flex flex-col">
			<a href="/">
				<div id="logo" class="flex justify-center pt-10">
					<Image src={logo} alt="Firebomb 2" loading="eager" />
				</div>
			</a>
			<!--<Nav client:load />-->
			<slot />
		</div>
		<Footer />
	</body>
</html>

<style>
	body {
		background-image: url("/screenshot_blur.png");
		background-color: rgba(0, 0, 0, 0.25);
		background-repeat: no-repeat;
		background-attachment: fixed;
		background-position: center;
		background-size: cover;
		background-blend-mode: darken;
		@apply min-h-[100vh];
	}
</style>
