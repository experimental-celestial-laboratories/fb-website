---
import logo from "../assets/logo.png";
import { Image } from "astro:assets";
---
<div class="fixed z-10 h-[8vh] w-full backdrop-blur-sm backdrop-brightness-80">
    <Image class="w-auto h-[8vh] p-[1vh] z-10 fixed m-0" src={logo} alt="Firebomb logo, a cartoon picture of a falling nuclear bomb, on fire."/>
    <p class="w-full mx-auto text-[#cccccc] text-center h-[8vh] py-[1vh] text-5xl/[6vh] font-serif hidden">Firebomb</p>
</div>